{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ppp-database.org/spec/datamodel/Complaint/",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "この項目は[主キー](https://ppp-database.org/howtouse/terms-2/#%E4%B8%BB%E3%82%AD%E3%83%BC)ですので、一旦割り当てた案件IDは変更する事はできません。\nNGSI-LDの仕様に合わせ、次の形式の識別子とする。”urn:ngsi-ld:Complaint:”<一意となる番号>。一意となる番号は事業者が交代しても一意となる様な運用が必要です。",
      "title": "案件ID"
    },
    "type": {
      "const": "Complaint",
      "description": "必ず”Complaint”の文字列でなくてはならない"
    },
    "phenomenon": {
      "type": "object",
      "properties": {
        "type": {
          "const": "StructuredValue"
        },
        "value": {
          "type": "object",
          "properties": {
            "category": {
              "title": "現象概要",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "remarks": {
              "title": "現象補足",
              "type": "string"
            }
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "不具合現象です。",
      "title": "現象"
    },
    "dataProvider": {
      "title": "プロバイダ",
      "description": "データのプロバイダのid。このWGが想定するシステムでは関係しないと考えます",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "description": {
      "title": "説明",
      "description": "説明を記載",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "isFiledTo": {
      "title": "提出先",
      "description": "苦情をエスカレーションする先。例えば自治体の所管課など",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "isMadeBy": {
      "title": "依頼者",
      "description": "この苦情を申し立てたユーザーの ID。個人情報にならない様に留意が必要。例えば、定期検査による検出はこの項目を記入するが、個人や利用者団体は記入しないなど。",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "isPartOf": {
      "title": "関連案件ID",
      "description": "ひとつの不具合が複数の「案件」から構成される場合などにこの項目で相互参照したり階層化したりします。各「案件」は基本的に「報告」からリンクされますが、「報告」登録後に追加で「案件」を追加登録されるケースも想定されます。その場合は追加登録した「案件」からこの「関連案件ID」で元の「案件」をリンクする事で、間接的に「報告」と結びつけます。",
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    "location": {
      "title": "座標",
      "description": "不具合の発生個所を座標で示します。例えば、道路の陥没、河川の汚染、街角の異臭などを想定しています。今回のユースケースとは合わないと考えます",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "geo:json"
        },
        "value": {
          "type": "object",
          "properties": {
            "type": {
              "const": "Point"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "type",
            "coordinates"
          ]
        }
      },
      "additionalProperties": false
    },
    "name": {
      "title": "案件名",
      "description": "案件の名称",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "seeAlso": {
      "title": "追加情報",
      "description": "追加情報のurlの列です",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "URL"
        },
        "value": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "title": "提供元",
      "description": "この情報の提供元に関するurl等を格納します",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "title": "ステータス",
      "description": "活動状況を登録します。”処置中”、”完了”など。用語について「[案件ステータス(ComplaintStatus)](https://ppp-database.org/spec/enum/complaintstatus/)」を参照してください",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "timestamps": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "title": "ステップ",
                "type": "string"
              },
              "timestamp": {
                "title": "日時",
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "step",
              "timestamp"
            ]
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "受付から完了に至る一連の手順における日付、または日時を登録します。予定も含めて構いません。尚、12条点検で報告する不具合については少なくとも受付の日時を記入すると共に、作業未実施の場合は作業予定の日時も記入します。",
      "title": "経緯"
    },
    "refFacility": {
      "title": "施設ID",
      "description": "案件の対象となる施設(Facility)に対するリンクです。FacilityのEntity idを格納します。refFacilityかrefBuildingのどちらかを必ず登録します。施設からBuildingを辿ることができます。",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Relationship"
        },
        "value": {
          "type": "string",
          "pattern": "^urn:ngsi-ld:Facility:.*",
          "x-refType": "Facility"
        }
      },
      "additionalProperties": false
    },
    "refBuilding": {
      "title": "建物ID",
      "description": "案件の対象となる建物(Building)に対するリンクです。BuildingのEntity idを格納します。refFacilityかrefBuildingのどちらかを必ず登録します。",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Relationship"
        },
        "value": {
          "type": "string",
          "pattern": "^urn:ngsi-ld:Building:.*",
          "x-refType": "Building"
        }
      },
      "additionalProperties": false
    },
    "zones": {
      "type": "object",
      "properties": {
        "type": {
          "const": "StructuredValue"
        },
        "value": {
          "type": "object",
          "properties": {
            "abstracts": {
              "type": "array",
              "items": [
                {
                  "title": "場所大分類",
                  "type": "string"
                },
                {
                  "title": "場所中分類",
                  "type": "string"
                },
                {
                  "title": "場所小分類",
                  "type": "string"
                }
              ]
            },
            "remarks": {
              "title": "場所補足",
              "type": "string"
            }
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "不具合発生の場所を格納します。列挙型項目の列と自由記述文字列の組み合わせで格納します。場所大分類・場所中分類・場所小分類は「建物」または「施設」のZonesから選択した文字列です。この項目は不具合の現象を検出した場所であり、修繕した場所と異なる可能性があります。修繕した場所は「修繕計画(repairPlan)」に登録します。",
      "title": "場所"
    },
    "parts": {
      "type": "object",
      "properties": {
        "type": {
          "const": "StructuredValue"
        },
        "value": {
          "type": "object",
          "properties": {
            "abstracts": {
              "title": "部位概要",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "refComponent": {
              "title": "部位ID",
              "type": "string",
              "x-refType": [
                "BuildingComponent",
                "Device"
              ]
            },
            "remarks": {
              "title": "部位補足",
              "type": "string"
            }
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "不具合を発生したBuildingComponent(部位)やDevice(設備)を示す",
      "title": "部位"
    },
    "cause": {
      "type": "object",
      "properties": {
        "type": {
          "const": "StructuredValue"
        },
        "value": {
          "type": "object",
          "properties": {
            "abstracts": {
              "title": "原因概要",
              "type": "string"
            },
            "remarks": {
              "title": "原因補足",
              "type": "string"
            }
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "不具合を発生させた原因。原因は「処置計画(repairPlan)」に記載する修繕の内容に対応したものである必要がある。修繕が完了し承認を得た後に現象が再発した場合は新たに「報告」や「案件」の登録を検討します。尚、「報告」や「案件」の登録例については[包括施設管理における使い方 (6/7)](https://ppp-database.org/howtouse/tutorial2-6/)もご覧ください。",
      "title": "原因"
    },
    "severityMark": {
      "title": "緊急度マーク",
      "description": "不具合に対する緊急性を示すマークを登録する項目です。登録する用語は[ComplaintSeverity](https://ppp-database.org/spec/enum/ComplaintSeverity/)をご覧ください。",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "severity": {
      "title": "緊急度補足",
      "description": "不具合に対する処置の緊急性を示す項目です。sevirityMarkに対する補足の位置づけとなります。例えば”放置すると機能不全に至る可能性あり”、”施設運営に影響あり”など",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "repairPlan": {
      "title": "修繕計画",
      "description": "処置の計画です。”部品交換”などと記載します。修繕する場所が「場所(zones)」と異なる場合は修繕した場所も記載します。また、修繕が複数の工程や複数の箇所に及ぶ場合は、出来る限りそれぞれの箇所や修繕内容が分かる様に記述します。",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type"
  ]
}
