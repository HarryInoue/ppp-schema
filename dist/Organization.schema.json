{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ppp-database.org/spec/datamodel/Organization/",
  "title": "法人",
  "type": "object",
  "properties": {
    "id": {
      "title": "法人ID",
      "type": "string",
      "description": "本データモデルの[主キー](https://ppp-database.org/howtouse/terms-2/#主キー)です。NGSI-LDの仕様に合わせ、次の形式の識別子とします。”urn:ngsi-ld:Organization:”<国名コード><法人番号>。国名コードは日本の場合は”JP”です。日本の法人番号を取得していない法人もあり得るため、国名コードを付けています。尚、日本以外の法人については、<法人番号>をどう定義するのか、必要時に再度検討する必要があります。同様に大半の町内会やボランティア団体は登記しておらず法人番号を持たないため、本データモデルのスコープを任意団体に広げる場合は、この文字列を再定義する必要があります"
    },
    "type": {
      "const": "Organization",
      "description": "NGSI V2およびNGSI-LDの仕様にあわせ、必ず”Organization”の文字列を登録します"
    },
    "identificationGroup": {
      "title": "ID情報",
      "type": "object",
      "properties": {
        "type": {
          "const": "IdentificationGroup"
        },
        "value": {
          "type": "array",
          "x-key": "identificationType",
          "items": {
            "allOf": [
              {
                "type": "object",
                "description": "identificationGroup.valueの配列要素の共通構造。identificationTypeのenumはモデルごとに異なるため、利用側でallOfにより追加すること。",
                "properties": {
                  "identificationType": {
                    "title": "ID種別",
                    "type": "string"
                  },
                  "identification": {
                    "title": "ID",
                    "type": "string"
                  }
                },
                "required": [
                  "identificationType",
                  "identification"
                ],
                "additionalProperties": false
              },
              {
                "properties": {
                  "identificationType": {
                    "enum": [
                      "法人番号",
                      "自治体コード"
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "この項目は、法人に関する各種IDを並べて登録するための「箱」です。詳しくはtypeにあるリンク先の共通パーツを参照して下さい。法人番号の登録は必須です。これは、GIFのコア・データモデルで必須と指定されているためです。自治体の場合は自治体コードも必須です。政令市の場合、区のコードではなく法人である市のコードを登録します。この点、住所の情報であるPostalAddressとは異なります"
    },
    "name": {
      "title": "法人名",
      "description": "法人の名称を設定する",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "containedInPlace": {
      "title": "県名",
      "description": "法人が基礎自治体、または東京都の特別区の場合は必須とし、都道府県名を記載する",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "nameKana": {
      "title": "法人名カナ",
      "description": "法人の名称のカナ表記を設定する",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "nameEn": {
      "title": "法人名英語",
      "description": "法人の名称の英語表記を設定する",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "organizationTypePosition": {
      "title": "組織種別位置",
      "description": "組織種別（株式会社等）を法人名の前後のどちらに付与するかを記載します",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "category": {
      "title": "組織種別",
      "description": "列挙型項目。”市区町村”、”都道府県”、”株式会社”などの区別を登録する。値は[OrganizationCategory](https://ppp-database.org/spec/enum/OrganizationCategory)を参照のこと。",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "alternateName": {
      "title": "通称",
      "description": "自治体の場合、”塩釜市”や”廣島市”など。略称のアルファベットも登録する",
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    "status": {
      "title": "活動状況",
      "description": "活動状況（倒産、破産、休眠、休業、廃業等）を記載。",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "description": {
      "title": "説明",
      "description": "この組織に関する説明を記載",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "url": {
      "title": "url",
      "description": "法人が開設しているWebサイトURLを記載。",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "URL"
        },
        "value": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "numberOfRegularEmployees": {
      "title": "正社員数",
      "description": "正社員数と従業員数を記載。この項目は変動する数値の項目であり、実装するのであれば誰が更新し続けるのかなどのルール策定が必要",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Integer"
        },
        "value": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "numberOfEmployees": {
      "title": "従業員数",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Integer"
        },
        "value": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "establishedDate": {
      "title": "設立年月日",
      "type": "object",
      "properties": {
        "type": {
          "const": "Date"
        },
        "value": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "設立日を記載"
    },
    "yearOfEstablishment": {
      "title": "創業年",
      "description": "創業年を西暦YYYY形式で記載",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "businessCategory": {
      "title": "事業種目",
      "description": "事業種目（[日本標準産業分類](https://www.soumu.go.jp/toukei_toukatsu/index/seido/sangyo/02toukatsu01_03000044.html)）を記載。　”都道府県機関”、”市町村機関”など",
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    "fiscalYearStartDay": {
      "title": "事業年度開始日",
      "description": "年度開始日を”MM-DD”形式で記載。省略時には”04-01″を指定したと解釈する",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "capital": {
      "title": "資本金",
      "description": "資本金を記載。この項目が必要な場合は、更新の責任をだれが負うのかなどの運用と、通貨の属性の必要性について検討が必要",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Integer"
        },
        "value": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "registeredAddress": {
      "title": "登記住所",
      "description": "法人の登記上の住所",
      "type": "object",
      "properties": {
        "type": {
          "const": "PostalAddress"
        },
        "value": {
          "type": "object",
          "properties": {
            "addressCountry": {
              "title": "国",
              "type": "string",
              "description": "国名または二文字の国コードで表現。日本の場合は\"Japan\"または\"JP\""
            },
            "addressRegion": {
              "title": "都道府県",
              "type": "string",
              "description": "日本国内の住所については都道府県名。"
            },
            "addressLocality": {
              "title": "市区町村",
              "type": "string",
              "description": "日本国内の住所については基礎自治体名。町村の場合は郡名も含む。政令市内の区名は次の「町字以下(streetAddress)」に登録する"
            },
            "streetAddress": {
              "title": "町字以下",
              "type": "string",
              "description": "日本国内の住所については基礎自治体名より後ろの部分で方書を除いた部分。政令指定市区名・町名・字名以降。町名より後ろは数字をハイフンで結んだ形式とする。例えば、\"霞が関2-1-6\"。方書は、建物の名称などをaddressとは別項目で表現する"
            },
            "postalCode": {
              "title": "郵便番号",
              "type": "string",
              "description": "日本国内の住所についてはハイフンを使わず、連続した7桁の数字からなる文字列。グローバル標準に合わせて項目を追加"
            }
          },
          "required": [
            "addressRegion",
            "addressLocality",
            "streetAddress"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "contactPoint": {
      "title": "連絡先",
      "description": "連絡先情報は法人と部門の両方にある。本項目は代表電話などを期待",
      "type": "object",
      "properties": {
        "type": {
          "const": "ContactPoint"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "availableLanguage": {
                "title": "対応言語",
                "type": "string"
              },
              "contactType": {
                "title": "連絡先種別",
                "type": "string"
              },
              "email": {
                "title": "メールアドレス",
                "type": "string",
                "format": "email"
              },
              "telephone": {
                "title": "電話番号",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "extension": {
                "title": "内線番号",
                "type": "string"
              },
              "formURL": {
                "title": "フォーム",
                "type": "string",
                "format": "uri"
              },
              "faxNumber": {
                "title": "FAX",
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "refFacility": {
      "title": "施設ID",
      "description": "民間企業の本社や自治体の本庁舎が実際に存在する施設へのリンクです。このリンクを経由して法人の住所情報が得られます。継承元のコア・データモデルに倣い必須としています。尚、業務上住所情報が不要な法人を登録する場合は必ずしも登録は必須ではありません。",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Relationship"
        },
        "value": {
          "type": "string",
          "pattern": "^urn:ngsi-ld:Facility:.*",
          "x-refType": "Facility"
        }
      },
      "additionalProperties": false
    },
    "architectOfficeRegNumber": {
      "title": "事務所登録番号",
      "description": "12条点検において、調査者や検査者の勤務先が建築士事務所のときに事務所登録番号を”○○知事登録第○○号”の形式で登録します。但し、本項目は統計分析やオープンデータに適さない可能性がありますので、蓄積するデータの目的に従って登録の要否を判断する必要があります。",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type"
  ]
}
