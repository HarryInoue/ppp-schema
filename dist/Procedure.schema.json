{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ppp-database.org/spec/datamodel/Procedure/",
  "title": "NGSI v2 Procedure Entity (Normalized - Refactored)",
  "type": "object",
  "required": [
    "id",
    "type",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^urn:ngsi-ld:Procedure:.*",
      "description": "測定や確認などを行う観測手順を一意に識別する識別子です。この項目は[主キー](https://ppp-database.org/howtouse/terms-2/#主キー)ですので、一旦割り当てた案件IDは変更する事はできません。\nNGSI-LDの仕様に合わせ、次の形式の識別子とします。文字列の”urn:ngsi-ld:Procedure:”<一意となる文字列>です。<一意となる文字列>は一意となる文字列であれば何でもよいですが、本項目値全体でurnの規格に合致する必要がある。",
      "title": "手順ID"
    },
    "type": {
      "type": "string",
      "const": "Procedure",
      "description": "必ず”Procedure”の文字列でなくてはなりません。"
    },
    "name": {
      "description": "この手順が示す作業の名称です。必須項目ではありませんが、人的作業を伴う場合は名称を付与する事を推奨します。",
      "title": "手順名",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "description": {
      "description": "この手順に関する概要説明です。",
      "title": "説明",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "refFacility": {
      "description": "この手順の対象となる施設を識別するためのIDです。手順が多数ある際の絞り込みなどに用いる情報です。",
      "title": "施設ID",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Relationship"
        },
        "value": {
          "type": "string",
          "pattern": "^urn:ngsi-ld:Facility:.*",
          "x-refType": "Facility"
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "description": "「作業指示(ProcedureStep)」を要素とするArrayです。出来る限り実際の手順の順序に合わせて登録する事を推奨します。",
      "title": "作業項目",
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "stepType"
                ],
                "properties": {
                  "stepType": {
                    "const": "measurement"
                  },
                  "name": {
                    "type": "string"
                  },
                  "stepNumber": {
                    "type": "integer"
                  },
                  "description": {
                    "type": "string"
                  },
                  "refFeatureOfInterest": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "observedProperty": {
                    "type": "string"
                  },
                  "refSensors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "unit": {
                    "type": "string"
                  },
                  "Precision": {
                    "type": "number"
                  },
                  "thresholds": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "min": {
                          "type": "number"
                        },
                        "inclusiveMin": {
                          "type": "boolean"
                        },
                        "max": {
                          "type": "number"
                        },
                        "inclusiveMax": {
                          "type": "boolean"
                        },
                        "actionOnBreach": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "stepType",
                  "action",
                  "expectedState"
                ],
                "properties": {
                  "stepType": {
                    "const": "check"
                  },
                  "name": {
                    "type": "string"
                  },
                  "stepNumber": {
                    "type": "integer"
                  },
                  "description": {
                    "type": "string"
                  },
                  "refFeatureOfInterest": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "action": {
                    "type": "string"
                  },
                  "expectedState": {
                    "type": "string"
                  },
                  "actionOnMismatch": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "stepType"
                ],
                "properties": {
                  "stepType": {
                    "const": "sample"
                  },
                  "name": {
                    "type": "string"
                  },
                  "stepNumber": {
                    "type": "integer"
                  },
                  "description": {
                    "type": "string"
                  },
                  "sampleSource": {
                    "type": "string"
                  },
                  "sampleTarget": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      }
    }
  }
}
