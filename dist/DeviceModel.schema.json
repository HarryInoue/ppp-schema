{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ppp-database.org/spec/datamodel/DeviceModel/",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "この項目は[主キー](https://ppp-database.org/howtouse/terms-2/#%E4%B8%BB%E3%82%AD%E3%83%BC)ですので、一旦割り当てた設備IDは変更する事はできません。\nNGSI-LDの仕様に合わせ、次の形式の識別子とします。”urn:ngsi-ld:DeviceModel:”<一意となる文字列>。一意となる文字列は、[識別子](https://ppp-database.org/standards/identifier/)として使って良い文字に限られます、例えば国名コードとメーカの法人番号の後にハイフンを挟んで型番を並べたものなど。",
      "title": "機種ID"
    },
    "type": {
      "const": "DeviceModel",
      "description": "必ず”DeviceModel”の文字列でなくてはならない"
    },
    "alternateName": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "通称を入れる (もしあれば)",
      "title": "通称"
    },
    "annotations": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "設備に関する注釈",
      "title": "注釈"
    },
    "brandName": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "機器のブランド名を設定する。例えば”しろくまくん”。",
      "title": "ブランド名"
    },
    "category": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "設備の種別。列挙型項目。定義は[BuildingComponent](https://ppp-database.org/spec/enum/BuildingComponent/)を参照。尚、設備の種別が階層化されているときは、高位の階層から順番に格納する。",
      "title": "設備種別"
    },
    "color": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "機器の色を設定する。例えば”白”",
      "title": "色"
    },
    "controlledProperty": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "検知・制御・計測する対象。列挙型項目。定義は[ControlledProperty](https://ppp-database.org/spec/enum/ControlledProperty/)。例えば”水位”、”温度”など。",
      "title": "制御対象"
    },
    "dataProvider": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "このEntityに対するプロバイダを特定する文字列。今回のユースケースではプロバイダは存在しません。",
      "title": "プロバイダ"
    },
    "description": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "機種情報として公開可能な詳細情報",
      "title": "説明"
    },
    "deviceClass": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "制約条件付きデバイス(constrained device)のクラスです。RFC7228で規定。制約条件付きデバイスではない場合、意味を持ちません",
      "title": "クラス"
    },
    "documentation": {
      "type": "object",
      "properties": {
        "type": {
          "const": "URL"
        },
        "value": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "デバイスのドキュメントに対するリンク",
      "title": "ドキュメント"
    },
    "energyLimitationClass": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "これも、デバイスのクラスです。RFC7228で規定されています",
      "title": "エネルギークラス"
    },
    "function": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "デバイスの機能です。SAREFで規定されており、levelControl, sensing, onOff, openClose, metering, eventNotificationなどがある",
      "title": "機能"
    },
    "image": {
      "type": "object",
      "properties": {
        "type": {
          "const": "URL"
        },
        "value": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "デバイスの写真等のurlです。",
      "title": "写真"
    },
    "manufacturerName": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "メーカ名を設定する。例えば”日立製作所”",
      "title": "メーカ名"
    },
    "modelName": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "機器のモデル名を設定する。例えば”RAS-DM28KE8″",
      "title": "モデル名"
    },
    "name": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "機種に個別に名称が付いているときに、その名称を設定する",
      "title": "機種名"
    },
    "owner": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "所有者のidです",
      "title": "所有者"
    },
    "seeAlso": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "追加情報のURIを格納します。つまり、idやurlが入ります。",
      "title": "追加情報"
    },
    "serviceLife": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Number"
        },
        "value": {
          "type": "integer"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "耐用年数です。会計上、税務上の耐用年数ではなく、実際に利用可能な年数です",
      "title": "耐用年数"
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "const": "URL"
        },
        "value": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "データ提供者のurlです",
      "title": "データー提供者"
    },
    "supportedProtocol": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "サポートしているプロトコルです",
      "title": "プロトコル"
    },
    "supportedUnits": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "サポートしている測定値の精度です",
      "title": "精度"
    }
  },
  "required": [
    "id",
    "type"
  ]
}
