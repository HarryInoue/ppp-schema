{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ppp-database.org/spec/datamodel/Facility/",
  "title": "施設",
  "type": "object",
  "properties": {
    "id": {
      "title": "施設ID",
      "type": "string",
      "description": "NGSI V2に準拠する際の[主キー](https://ppp-database.org/howtouse/terms-2/#%E4%B8%BB%E3%82%AD%E3%83%BC)です。一旦割り当てた施設IDは変更する事はできません。。NGSI-LDの仕様に合わせ、次の形式の識別子とします。”urn:ngsi-ld:Facility:”<通番>。<通番>は全ての施設で一意となる文字列です。例えば採番時に施設を所有する法人の<国名コード><法人番号>-<管理通番>などです。ここでいう管理通番はオーナーの法人内で施設を一意に識別する文字列です。尚、オーナーの法人が替わるなどにより法人番号や管理通番が変わっても、施設として継続している場合はこの施設IDは変更してはならない決まりです。"
    },
    "type": {
      "const": "Facility",
      "description": "必ず”Facility”の文字列でなくてはならない決まりです。NGSI V2に準拠しない場合は不要です。"
    },
    "name": {
      "title": "施設名",
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "正式な施設名を日本語で設定する"
    },
    "nameKana": {
      "title": "施設名カナ",
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "施設のカナ表記を設定する。GIFで必須となっているため必須としています。"
    },
    "nameEn": {
      "title": "施設名英語",
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "施設の米国英語表記を設定する"
    },
    "alternateName": {
      "title": "通称",
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "住民や来街者からの問い合わせや掲示などで使われる一般的な通称がある場合はリスト構造で列挙します。公共施設ドメインの場合、省略すると通称はないと解釈されます"
    },
    "facilityID": {
      "title": "管理通番",
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "オーナーが管理対象の施設を区別するために付番した文字列です。事業者によっては施設IDや施設番号などと表現する事がありますが、項目の呼称「施設ID(id)」と混同する可能性があるため共通データ仕様では管理通番と表現しています。施設管理では基本的にこの「施設(Facility)」を管理単位としますが、データ仕様上は「建物(Building)」を管理対象とすることも可能です。本項目は管理対象をFacilityとする場合には必須です。また複合施設等に入居するテナント施設の場合もデータ管理上附番しておくことが望ましいです。"
    },
    "category": {
      "title": "施設大分類",
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "施設の分類。GIFのPOIの大分類の名称を登録。GIFの規定上必須となっているので本仕様も必須としているが、必ずしも該当する分類があるとは限らない。例えば”給食センター”などはない"
    },
    "subcategory": {
      "title": "施設小分類",
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "施設の分類。GIFのPOIの小分類の名称を登録。GIFの規定上必須となっているので本仕様も必須としているが、必ずしも該当する分類があるとは限らない。"
    },
    "originalCategory": {
      "title": "施設分類",
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "POI以外の分類がある場合に登録。独自の分類で構わない。分類が階層構造になっている場合は大まかな分類から順にリストで登録"
    },
    "abstract": {
      "title": "施設概要",
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "施設情報として公開可能なリード文です。"
    },
    "description": {
      "title": "施設説明",
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "施設の概要を記載します。"
    },
    "status": {
      "title": "ステータス",
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "施設の状態です。”計画中”、”準備中”、”稼働中”、”一時閉鎖”、”閉鎖中”、”廃止”などを登録します。施設が廃止されても、統計データや分析データは残るためこのデータモデルのデータも削除できません。そこで、この項目に”廃止”などと記述する事で存在する施設の情報なのかどうかを区別します。この項目には用語は定義されていません。定義が必要な場合はこのページの一番上の「コメント投稿」から事務局に連絡してください。"
    },
    "shelter": {
      "title": "防災施設情報",
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "防災施設を示す属性。例えば[“指定緊急避難場所”, “洪水”, “地震”]など"
    },
    "postalCode": {
      "title": "個別郵便番号",
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "施設が個別郵便番号を有する場合に登録する。このAttributeに登録が無い場合は、リンクを辿ってLandのpostalCodeを参照する"
    },
    "refBuilding": {
      "title": "建物ID",
      "type": "object",
      "properties": {
        "type": {
          "const": "Relationship"
        },
        "value": {
          "type": "string",
          "x-refType": "Building"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "入居するBuilding(建物)へのリンクです。リンクを辿ることで住所)やビル名を求めることができます"
    },
    "floor": {
      "title": "フロア",
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "入居する建物内の位置。方書にフロア情報も必要な場合に登録"
    },
    "openingHours": {
      "title": "開館時間",
      "type": "object",
      "properties": {
        "type": {
          "const": "OpeningHours"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "曜日ごとの開館閉館時刻の配列。"
    },
    "openingHoursRemarks": {
      "title": "開館時間補足",
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "openingHoursの定型では表現できない施設の利用日時情報"
    },
    "chargeType": {
      "title": "料金種別",
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "料金の種別。”有料”、”年額”、”月額”、”無料”など"
    },
    "price": {
      "title": "料金",
      "type": "object",
      "properties": {
        "type": {
          "const": "Integer"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "施設利用に必要な基本料金を日本円で記載(1円単位)"
    },
    "priceRemarks": {
      "title": "料金備考",
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "料金の備考。例: “１グループ1000円”、または”大人１名1500円、子供１名500円(18歳以下)、65歳以上１名1000円”など"
    },
    "paymentMethod": {
      "title": "決済種別",
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "料金の支払方法。列挙型項目。列挙型メンバは、[http://schema.org/paymentMethod](http://schema.org/paymentMethod)を参照"
    },
    "peopleCapacity": {
      "title": "収容人数",
      "type": "object",
      "properties": {
        "type": {
          "const": "Integer"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "定員"
    },
    "accessMethod": {
      "title": "アクセス方法",
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "公共交通や車でのアクセス方法を記載します。"
    },
    "refOffStreetParking": {
      "title": "駐車場ID",
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "駐車場情報のid。駐車可能な台数などの説明、料金、優先駐車場の有無などを辿れる。データモデルはSmart Data Modelsの[OffStreetParking](https://github.com/smart-data-models/dataModel.Parking/tree/a8d826a5ba45ccfe2f4d35273a5c4bfb05d85117/OffStreetParking)を参照されたい"
    },
    "areaServed": {
      "title": "サービス担当区域",
      "type": "object",
      "properties": {
        "type": {
          "const": "Array"
        },
        "value": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "region": {
                    "title": "都道府県",
                    "type": "string"
                  },
                  "subRegion": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "locality": {
                          "title": "市区町村",
                          "type": "string"
                        },
                        "street": {
                          "title": "町字以下",
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "Polygon"
                },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                }
              },
              "required": [
                "type",
                "coordinates"
              ]
            }
          ]
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "この施設がサービスを提供する区域をポリゴンで指定する。前項とどちらかしか登録できない"
    },
    "areaServedaRemarks": {
      "title": "サービス担当区域備考",
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    "contactPoint": {
      "title": "連絡先",
      "type": "object",
      "properties": {
        "type": {
          "const": "ContactPoint"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "availableLanguage": {
                "title": "対応言語",
                "type": "string"
              },
              "contactType": {
                "title": "連絡先種別",
                "type": "string"
              },
              "email": {
                "title": "メールアドレス",
                "type": "string",
                "format": "email"
              },
              "telephone": {
                "title": "電話番号",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "extension": {
                "title": "内線番号",
                "type": "string"
              },
              "formURL": {
                "title": "フォーム",
                "type": "string",
                "format": "uri"
              },
              "faxNumber": {
                "title": "FAX",
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "施設の代表電話などを登録する"
    },
    "refOperationManager": {
      "title": "運営者",
      "type": "object",
      "properties": {
        "type": {
          "const": "Relationship"
        },
        "value": {
          "type": "string",
          "x-refType": [
            "Organization",
            "Department"
          ]
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "運営を担当している法人へのリンク。自治体の場合、包括施設管理事業者の場合、および第三の事業者の場合などがある"
    },
    "refFacilityManager": {
      "title": "管理者",
      "type": "object",
      "properties": {
        "type": {
          "const": "Relationship"
        },
        "value": {
          "type": "string",
          "x-refType": [
            "Organization",
            "Department"
          ]
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "施設を管理する事業者の「法人」Entityへのリンクの情報。包括施設管理業務委託の場合は包括施設管理事業者へのリンク"
    },
    "accessibility": {
      "title": "アクセシビリティ情報",
      "type": "object",
      "properties": {
        "type": {
          "const": "Accessibility"
        },
        "value": {
          "type": "object",
          "properties": {
            "wheelchairAccessible": {
              "type": "boolean"
            },
            "wheelchairRental": {
              "type": "boolean"
            },
            "caneRental": {
              "type": "boolean"
            },
            "multipurposeToilet": {
              "type": "boolean"
            },
            "ramp": {
              "type": "boolean"
            },
            "elevator": {
              "type": "boolean"
            },
            "escalator": {
              "type": "boolean"
            },
            "mobilitySupportForBrailleBlocks": {
              "type": "boolean"
            },
            "brailleAndReadingAssistance": {
              "type": "boolean"
            },
            "accompaniedByGuideDogsAndServiceDogs": {
              "type": "boolean"
            },
            "subtitles": {
              "type": "boolean"
            },
            "writingSupport": {
              "type": "boolean"
            },
            "toiletForOstomates": {
              "type": "boolean"
            },
            "remarks": {
              "type": "string"
            },
            "priorityParking": {
              "type": "boolean"
            },
            "publicPhoneForWheelchairUsers": {
              "type": "boolean"
            },
            "barrierFreeFloor": {
              "type": "boolean"
            },
            "handrail": {
              "type": "boolean"
            },
            "automaticDoor": {
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "施設のバリアフリー情報などを登録します。"
    },
    "childCare": {
      "title": "子育て支援情報",
      "type": "object",
      "properties": {
        "type": {
          "const": "ChildCare"
        },
        "value": {
          "type": "object",
          "properties": {
            "childCareType": {
              "type": "string"
            },
            "childCareFee": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "unitText": {
                    "type": "string"
                  },
                  "price": {
                    "type": "integer"
                  },
                  "priceCurrency": {
                    "type": "string"
                  }
                },
                "required": [
                  "unitText",
                  "price",
                  "priceCurrency"
                ]
              }
            },
            "childCareFeeRemarks": {
              "type": "string"
            },
            "minAge": {
              "type": "integer"
            },
            "minAgeInMonths": {
              "type": "integer"
            },
            "maxAge": {
              "type": "integer"
            },
            "childCareOpeningHours": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nursery": {
              "type": "boolean"
            },
            "diaperChangingCorner": {
              "type": "boolean"
            },
            "foodAndDrinkAvailable": {
              "type": "boolean"
            },
            "strollerRental": {
              "type": "boolean"
            },
            "strollerUse": {
              "type": "boolean"
            },
            "remarks": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "子育て施設の場合、受け入れ年齢と一時預かりの有無の情報の登録を推奨。共通パーツを参照"
    },
    "facilityParent": {
      "title": "主施設ID",
      "type": "object",
      "properties": {
        "type": {
          "const": "Relationship"
        },
        "value": {
          "type": "string",
          "x-refType": "Facility"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "複合施設へ入居するテナント施設)において、建物や土地を含めた複合施設全体を表す「施設」の施設IDを登録します。施設全体を表す「施設」の場合はこの項目を登録しません。またはNULLを登録します。入居施設とは複合施設のテナント施設だけでなく、例えば学校に臨時的に設置する避難所、公共施設に併設する防災倉庫などがあります。"
    },
    "usage": {
      "title": "用途",
      "type": "object",
      "properties": {
        "type": {
          "const": "Text"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "description": "消防法施行令別表第一に掲げる防火対象物の用途。http://www.chikuta119.jp/info/ihan_kohyo/pdf/beppyo01.pdf"
    },
    "refDepartment": {
      "title": "所管部門ID",
      "type": "object",
      "properties": {
