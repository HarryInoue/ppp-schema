{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ppp-database.org/spec/part/CommonParts.schema.json",
  "title": "NGSI v2 Common Attribute Definitions",
  "description": "Commonly used attribute definitions and relationships for NGSI v2 Normalized entities.",
  
  "$defs": {
    
    "TextAttribute": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Text" },
        "value": { "type": "string" }
      },
      "additionalProperties": false
    },
    
    "NumberAttribute": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Number" },
        "value": { "type": "number" }
      },
      "additionalProperties": false
    },

    "IntegerAttribute": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Integer" },
        "value": { "type": "integer" }
      },
      "additionalProperties": false
    },

    "ArrayAttributeText": {
      "type": "object",
      "properties": {
        "type": {"const": "Array"},
        "value": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "required": ["type", "value"]
    },
    
    "DateAttribute": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Date" },
        "value": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    
    "DateTimeAttribute": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "DateTime" },
        "value": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    
    "UrlAttribute": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "URL" },
        "value": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },

    "IdentificationItem": {
      "type": "object",
      "description": "identificationGroup.valueの配列要素の共通構造。identificationTypeのenumはモデルごとに異なるため、利用側でallOfにより追加すること。",
      "properties": {
        "identificationType": { "title": "ID種別", "type": "string" },
        "identification": { "title": "ID", "type": "string" }
      },
      "required": ["identificationType", "identification"],
      "additionalProperties": false
    },

    "RelationshipAttributeDevice": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Relationship" },
        "value": { "type": "string", "pattern": "^urn:ngsi-ld:Device:.*", "x-refType": "Device" }
      },
      "additionalProperties": false
    },

    "RelationshipAttributeDeviceModel": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Relationship" },
        "value": { "type": "string", "pattern": "^urn:ngsi-ld:DeviceModel:.*", "x-refType": "DeviceModel" }
      },
      "additionalProperties": false
    },

    "RelationshipAttributeFacility": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Relationship" },
        "value": { "type": "string", "pattern": "^urn:ngsi-ld:Facility:.*", "x-refType": "Facility" }
      },
      "additionalProperties": false
    },

    "RelationshipAttributeBuilding": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Relationship" },
        "value": { "type": "string", "pattern": "^urn:ngsi-ld:Building:.*", "x-refType": "Building" }
      },
      "additionalProperties": false
    },

    "RelationshipAttributeBuildingComponent": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Relationship" },
        "value": { "type": "string", "pattern": "^urn:ngsi-ld:BuildingComponent:.*", "x-refType": "BuildingComponent" }
      },
      "additionalProperties": false
    },

    "RelationshipAttributeProcedure": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Relationship" },
        "value": { "type": "string", "pattern": "^urn:ngsi-ld:Procedure:.*", "x-refType": "Procedure" }
      },
      "additionalProperties": false
    }
  }
}