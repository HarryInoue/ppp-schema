{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ppp-database.org/spec/datamodel/BuildingComponent/",
  "type": "object",
  "properties": {
    "id": {"type": "string"},
    "type": {"const": "BuildingComponent"},
    "category": {
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "name": {
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "nameKana": {
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "nameEn": {
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "description": {
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "status": {
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "refFacility": {
      "type": "object",
      "properties": {
        "type": {"const": "Relationship"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "refBuilding": {
      "type": "object",
      "properties": {
        "type": {"const": "Relationship"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "url": {
      "type": "object",
      "properties": {
        "type": {"const": "URL"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "remarks": {
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "zoneInstalled": {
      "type": "object",
      "properties": {
        "type": {"const": "Array"},
        "value": {
          "type": "array",
          "items": {"type": "string"},
          "maxItems": 3
        }
      },
      "required": ["type", "value"]
    },
    "zoneRemarks": {
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    }
  },
  "required": ["id", "type"]
}
  