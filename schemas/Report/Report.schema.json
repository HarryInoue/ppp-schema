{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ppp-database.org/spec/datamodel/Report/",
  "type": "object",
  "properties": {
    "id": {"type": "string"},
    "type": {"const": "Report"},
    "timestamp": {
      "type": "object",
      "properties": {
        "type": {"const": "Date"},
        "value": {
          "type": "string",
          "format": "date"
        }
      },
      "required": ["type", "value"]
    },
    "category": {
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "dateOperation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "Date" },
            "value": {
              "type": "string",
              "format": "date"
            }
          },
          "required": ["type", "value"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "Array" },
            "value": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "date"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": ["type", "value"]
        }
      ]
    },
    "operationName": {
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "refSubmitter": {
      "type": "object",
      "properties": {
        "type": {"const": "Relationship"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "inspector": {
      "type": "object",
      "properties": {
        "type": {"const": "Array"},
        "value": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "required": ["type", "value"]
    },
    "reportParent": {
      "type": "object",
      "properties": {
        "type": {"const": "Relationship"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "refTarget": {
      "type": "object",
      "properties": {
        "type": {"const": "Relationship"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "refFacility": {
      "type": "object",
      "properties": {
        "type": {"const": "Relationship"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "refComplaint": {
      "type": "object",
      "properties": {
        "type": {"const": "Array"},
        "value": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "required": ["type", "value"]
    },
    "equipment": {
      "type": "object",
      "properties": {
        "type": {"const": "Array"},
        "value": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "required": ["type", "value"]
    },
    "damageControl": {
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "pictures": {
      "type": "object",
      "properties": {
        "type": {"const": "Array"},
        "value": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "no": {"type": "string"},
              "url": {
                "type": "string",
                "format": "uri"
              },
              "remarks": {"type": "string"}
            }
          }
        }
      },
      "required": ["type", "value"]
    },
    "request": {
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "remarks": {
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "opinion": {
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "document": {
      "type": "object",
      "properties": {
        "type": {"const": "Array"},
        "value": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {"type": "string"},
              "fileName": {"type": "string"},
              "filePath": {"type": "string"},
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": ["title", "fileName"]
          }
        }
      },
      "required": ["type", "value"]
    }
  },
  "required": ["id", "type"]
}
  