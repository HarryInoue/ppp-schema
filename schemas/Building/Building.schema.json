{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ppp-database.org/spec/datamodel/Building/",    
  "title": "建物",
  "type": "object",
  "properties": {
    "id": {
      "title": "建物ID",
      "type": "string"
    },
    "type": {"const": "Building"},
    "category": {
      "title": "用途（建築基準法）",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "name": {
      "title": "建物名",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "nameKana": {
      "title": "建物名カナ",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "nameEn": {
      "title": "建物名英語",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "alternateName": {
      "title": "通称",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "required": ["type", "value"]
    },
    "facilityID": {
      "title": "管理通番",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "abstract": {
      "title": "概要",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "description": {
      "title": "説明",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "status": {
      "title": "状態",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "refLand": {
      "title": "土地ID",
      "type": "object",
      "properties": {
        "type": {"const": "Relationship"},
        "value": {
          "type": "array",
          "items": {"type": "string"},
          "x-refType": "Land"
        }
      },
      "required": ["type", "value"]
    },
    "mainFunctions": {
      "title": "主要機能",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "usage": {
      "title": "用途（都市計画）",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "buildingArea": {
      "title": "建築面積",
      "type": "object",
      "properties": {
        "type": {"const": "Number"},
        "value": {"type": "number"}
      },
      "required": ["type", "value"]
    },
    "totalFloorArea": {
      "title": "総床面積",
      "type": "object",
      "properties": {
        "type": {"const": "Number"},
        "value": {"type": "number"}
      },
      "required": ["type", "value"]
    },
    "maximumHeight": {
      "title": "最高の高さ",
      "type": "object",
      "properties": {
        "type": {"const": "Number"},
        "value": {"type": "number"}
      },
      "required": ["type", "value"]
    },
    "floorsAboveGround": {
      "title": "地上階数",
      "type": "object",
      "properties": {
        "type": {"const": "Number"},
        "value": {"type": "number"}
      },
      "required": ["type", "value"]
    },
    "floorsBelowGround": {
      "title": "地下階数",
      "type": "object",
      "properties": {
        "type": {"const": "Number"},
        "value": {"type": "number"}
      },
      "required": ["type", "value"]
    },
    "floorsRoofStructure": {
      "title": "塔屋階数",
      "type": "object",
      "properties": {
        "type": {"const": "Number"},
        "value": {"type": "number"}
      },
      "required": ["type", "value"]
    },
    "structure": {
      "title": "構造",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "completionDate": {
      "title": "竣工日",
      "type": "object",
      "properties": {
        "type": {"const": "Date"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "completionYear": {
      "title": "竣工年度",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "accessibility": {
      "title": "アクセシビリティ情報",
      "type": "object",
      "properties": {
        "type": {"const": "Accessibility"},
        "value": {
          "type": "object",
          "properties": {
            "wheelchairAccessible": {"type": "boolean"},
            "wheelchairRental": {"type": "boolean"},
            "caneRental": {"type": "boolean"},
            "multipurposeToilet": {"type": "boolean"},
            "ramp": {"type": "boolean"},
            "elevator": {"type": "boolean"},
            "escalator": {"type": "boolean"},
            "mobilitySupportForBrailleBlocks": {"type": "boolean"},
            "brailleAndReadingAssistance": {"type": "boolean"},
            "accompaniedByGuideDogsAndServiceDogs": {"type": "boolean"},
            "subtitles": {"type": "boolean"},
            "writingSupport": {"type": "boolean"},
            "toiletForOstomates": {"type": "boolean"},
            "remarks": {"type": "string"},
            "priorityParking": {"type": "boolean"},
            "publicPhoneForWheelchairUsers": {"type": "boolean"},
            "barrierFreeFloor": {"type": "boolean"},
            "handrail": {"type": "boolean"},
            "automaticDoor": {"type": "boolean"}
          }
        }
      },
      "required": ["type", "value"]
    },
    "floorArea": {
      "title": "フロア床面積",
      "type": "object",
      "properties": {
        "type": {"const": "Number"},
        "value": {"type": "number"}
      },
      "required": ["type", "value"]
    },
    "acquisitionPrice": {
      "title": "取得価格",
      "type": "object",
      "properties": {
        "type": {"const": "Number"},
        "value": {"type": "number"}
      },
      "required": ["type", "value"]
    },
    "performanceVerificationMethod": {
      "title": "性能検証法",
      "type": "object",
      "properties": {
        "type": {"const": "Array"},
        "value": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "required": ["type", "value"]
    },
    "propertyClass": {
      "title": "財産区分",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "usePermission": {
      "title": "行政財産使用許可",
      "type": "object",
      "properties": {
        "type": {"const": "Boolean"},
        "value": {"type": "boolean"}
      },
      "required": ["type", "value"]
    },
    "mixedUseFacility": {
      "title": "複合施設",
      "type": "object",
      "properties": {
        "type": {"const": "Boolean"},
        "value": {"type": "boolean"}
      },
      "required": ["type", "value"]
    },
    "ownership": {
      "title": "所有形態",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "rebuildingPlan": {
      "title": "更新予定時期",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "rebuildingCost": {
      "title": "更新費用",
      "type": "object",
      "properties": {
        "type": {"const": "Number"},
        "value": {"type": "number"}
      },
      "required": ["type", "value"]
    },
    "serviceLife": {
      "title": "耐用年数",
      "type": "object",
      "properties": {
        "type": {"const": "Number"},
        "value": {"type": "number"}
      },
      "required": ["type", "value"]
    },
    "numberOfBuildings": {
      "title": "棟数",
      "type": "object",
      "properties": {
        "type": {"const": "Number"},
        "value": {"type": "number"}
      },
      "required": ["type", "value"]
    },
    "asbestosControl": {
      "title": "アスベスト対策",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "seismicDesignStandard": {
      "title": "耐震基準",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "seismicAssessment": {
      "title": "耐震診断",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "seismicRetrofit": {
      "title": "耐震改修",
      "type": "object",
      "properties": {
        "type": {"const": "Text"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "map": {
      "title": "地図",
      "type": "object",
      "properties": {
        "type": {"const": "URL"},
        "value": {"type": "string"}
      },
      "required": ["type", "value"]
    },
    "areaByUseByFloor": {
      "title": "フロア別用途別床面積",
      "type": "object",
      "properties": {
        "type": {"const": "StructuredValue"},
        "value": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "floor": {
                "title": "フロア",
                "type": "string"
              },
              "floorInformation": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "use": {
                      "title": "用途",
                      "type": "string"
                    },
                    "area": {
                      "title": "面積",
                      "type": "number"
                    }
                  },
                  "required": ["use", "area"]
                }
              }
            },
            "required": ["floor", "floorInformation"]
          }
        }
      },
      "required": ["type", "value"]
    },
    "areaByUse": {
      "title": "用途別床面積",
      "type": "object",
      "properties": {
        "type": {"const": "Array"},
        "value": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "use": {
                "title": "用途",
                "type": "string"
              },
              "area": {
                "title": "面積",
                "type": "number"
              }
            },
            "required": ["use", "area"]
          }
        }
      },
      "required": ["type", "value"]
    },
    "refDepartment": {
      "title": "部門ID",
      "type": "object",
      "properties": {
        "type": {"const": "Relationship"},
        "value": {
          "type": "string",
          "x-refType": "Facility"
        }
      },
      "required": ["type", "value"]
    },
    "identificationGroup": {
      "title": "ID情報",
      "type": "object",
      "properties": {
        "type": {"const": "IdentificationGroup"},
        "value": {
          "type": "array",
          "x-key": "identificationType",
          "items": {
            "type": "object",
            "properties": {
              "identificationType": {
                "title": "ID種別",
                "type": "string",
                "enum": ["不動産ID"]
              },
              "identification": {
                "title": "ID",
                "type": "string"}
            },
            "required": ["identificationType", "identification" ],
            "additionalProperties": false
          }
        }
      },
      "required": ["type", "value"]
    },
    "refParking": {
      "title": "駐車場ID",
      "type": "object",
      "properties": {
        "type": {"const": "Relationship"},
        "value": {
          "type": "string"}
      },
      "required": ["type", "value"]
    },
    "refOwner": {
      "title": "法人ID",
      "type": "object",
      "properties": {
        "type": {"const": "Relationship"},
        "value": {
          "type": "string",
          "x-refType": "Organization"
        }
      },
      "required": ["type", "value"]
    },
    "zones": {
      "title": "場所",
      "type": "object",
      "properties": {
        "type": {"const": "Array"},
        "value": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "zoneName": {
                "title": "場所大分類",
                "type": "string"
              },
              "subzones": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "subzoneName": {
                      "type": "array",
                      "items": [
                        {
                          "title": "場所中分類",
                          "type": "string"
                        },
                        {
                          "title": "場所小分類",
                          "type": "array",
                          "items": {"type": "string"}
                        }
                      ]
                    }
                  }
                }
              }
            },
            "required": ["zoneName"]
          }
        }
      },
      "required": ["type", "value"]
    },
    "refFacilityManager": {
      "title": "施設管理者ID",
      "type": "object",
      "properties": {
        "type": {"const": "Relationship"},
        "value": {
          "type": "string",
          "x-refType": "Organization"
        }
      },
      "required": ["type", "value"]
    },
    "buildingParent": {
      "title": "親建物ID",
      "type": "object",
      "properties": {
        "type": {"const": "Relationship"},
        "value": {
          "type": "string",
          "x-refType": "Building"
      }
      },
      "required": ["type", "value"]
    },
    "permits": {
      "title": "認可証",
      "type": "object",
      "properties": {
        "type": {"const": "Array"},
        "value": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "title": "名称",
                "type": "string"
              },
              "permitter": {
                "title": "発行者",
                "type": "string"
              },
              "permitNumber": {
                "title": "交付番号",
                "type": "string"
              },
              "datePermitted": {
                "title": "交付日",
                "type": "string"
              }
            },
            "required": ["name", "permitter", "permitNumber", "datePermitted"]
          }
        }
      },
      "required": ["type", "value"]
    },
    "history": {
      "title": "履歴",
      "type": "object",
      "properties": {
        "type": {"const": "Array"},
        "value": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dateRenovated": {
                "title": "改修日付",
                "type": "string"
              },
              "renovation": {
                "title": "改修内容",
                "type": "string"
              }
            },
            "required": ["dateRenovated", "renovation"]
          }
        }
      },
      "required": ["type", "value"]
    },
    "ventilation": {
      "title": "排気設備",
      "type": "object",
      "properties": {
        "type": {"const": "Array"},
        "value": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "roomClassification": {
                "title": "室用途",
                "type": "string"
              },
              "descriptions": {
                "title": "説明",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "method": {
                      "title": "方式",
                      "type": "string"
                    },
                    "zone": {
                      "title": "対象",
                      "type": "string"
                    }
                  },
                  "required": ["method", "zone"]
                }
              }
            },
            "required": ["roomClassification", "descriptions"]
          }
        }
      },
      "required": ["type", "value"]
    },
    "smokeExtraction": {
      "title": "排煙設備",
      "type": "object",
      "properties": {
        "type": {"const": "Array"},
        "value": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "roomClassification": {
                "title": "室用途",
                "type": "string"
              },
              "descriptions": {
                "title": "説明",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "method": {
                      "title": "方式",
                      "type": "string"
                    },
                    "zone": {
                      "title": "対象",
                      "type": "string"
                    }
                  },
                  "required": ["method", "zone"]
                }
              }
            },
            "required": ["roomClassification", "descriptions"]
          }
        }
      },
      "required": ["type", "value"]
    }
  },
  "required": ["id","type"],
  "additionalProperties": false
}