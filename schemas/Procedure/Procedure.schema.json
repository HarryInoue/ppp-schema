{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ppp-database.org/spec/datamodel/Procedure/",
  "title": "NGSI v2 Procedure Entity (Normalized - Refactored)",
  "type": "object",
  "required": ["id", "type", "steps"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^urn:ngsi-ld:Procedure:.*",
      "description": "Entity ID (URN format)"
    },
    "type": {
      "type": "string",
      "const": "Procedure",
      "description": "Entity Type"
    },
    "name": { "$ref": "../CommonParts.schema.json#/$defs/TextAttribute" },
    "description": { "$ref": "../CommonParts.schema.json#/$defs/TextAttribute" },
    "refFacility": { "$ref": "../CommonParts.schema.json#/$defs/RelationshipAttributeFacility" },
    "steps": { "$ref": "#/$defs/StepsAttribute" }
  },
  "$defs": {
    "StepsAttribute": {
      "type": "object",
      "description": "Peocedureを構成する各ステップのArray",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "Array" },
        "value": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "../../parts/ProcedureStep.schema.json#/$defs/MeasurementStep" },
              { "$ref": "../../parts/ProcedureStep.schema.json#/$defs/CheckStep" },
              { "$ref": "../../parts/ProcedureStep.schema.json#/$defs/SampleStep" }
            ]
          }
        }
      }
    }
  }
}
